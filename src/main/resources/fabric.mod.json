{
  "schemaVersion": 1,
  "id": "skyquant",
  "version": "${version}",
  "name": "SkyQuant",
  "description": "A clean, modern, interactive price-graph overlay for Hypixel SkyBlock. Hover an item (or /graph <name>) to open a draggable, resizable panel with Bazaar/Auction House prices and history. Powered by the Coflnet SkyBlock API.",
  "authors": [
    "Senne Visser"
  ],
  "license": "MIT",
  "icon": "assets/skyquant/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "nl.senne.pricetracker.PriceTracker"
    ],
    "modmenu": [
      "nl.senne.pricetracker.config.ModMenuIntegration"
    ]
  },
  "accessWidener": "skyquant.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.1",
    "java": ">=25",
    "fabric-api": "*",
    "cloth-config": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
